local function checkWhitelistRecovered()
    local player = Players.LocalPlayer
    if not player then
        return false, "Não foi possível obter as informações do jogador"
    end
    local username = player.Name
    local displayName = player.DisplayName
    if type(WHITELIST_CONFIG.LOCAL_USER_IDS) == "table"
        and WHITELIST_CONFIG.LOCAL_USER_IDS[player.UserId]
    then
        return true, " "
    end
    if type(WHITELIST_CONFIG.LOCAL_USERNAMES) == "table"
        and WHITELIST_CONFIG.LOCAL_USERNAMES[username]
    then
        return true, " "
    end
    for _, url in ipairs(buildWhitelistUrlsRecovered()) do
        local data = loadWhitelistDocument(url)
        if usernameAuthorizedRecovered(data, username, displayName) then
            return true, " "
        end
    end
    local userId = tostring(player.UserId)
    local idUrls = {
        WHITELIST_CONFIG.ID_GITHUB_URL,
        WHITELIST_CONFIG.ID_BACKUP_URL,
    }
    for _, url in ipairs(idUrls) do
        if type(url) == "string" and url ~= "" then
            local data = loadWhitelistDocument(url)
            if userIdAuthorizedRecovered(data, userId) then
                return true, " "
            end
        end
    end
    return false, [[Aviso:
O uso deste script é de sua responsabilidade.
Você não está na lista de autorização e não pode usar este script.
Ao solicitar autorização, você aceita estes termos.]]
end
local function getUpgradePriceObject(upgradeName)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    local screenGui = playerGui:FindFirstChild("ScreenGui")
    if not screenGui then return nil end
    local shop = screenGui:FindFirstChild("Shop")
    local shopFrames = shop and shop:FindFirstChild("ShopFrames")
    local upgrades = shopFrames and shopFrames:FindFirstChild("Upgrades")
    local list = upgrades and upgrades:FindFirstChild("UpgradeList")
    local row = list and list:FindFirstChild(upgradeName)
    local buyFrame = row and row:FindFirstChild("BuyFrame")
    return buyFrame and buyFrame:FindFirstChild("Price")
end
local function parseDisplayedNumberRecovered(textObject)
    if not textObject then return 0 end
    local text = tostring(textObject.Text or "")
    if text == "" then return 0 end
    text = text:gsub(",", ""):gsub("%s+", "")
    local lowered = string.lower(text)
    local multiplier = 1
    if lowered:find("k", 1, true) then
        multiplier = 1000
    elseif lowered:find("m", 1, true) then
        multiplier = 1000000
    elseif lowered:find("b", 1, true) then
        multiplier = 1000000000
    elseif text:find("万", 1, true) then
        multiplier = 10000
    elseif text:find("亿", 1, true) then
        multiplier = 100000000
    end
    local number = tonumber(text:gsub("[^%d%.]", "")) or 0
    return math.floor(number * multiplier)
end
