-- Proto 185, linhas ~2315–2329.
-- Há duas chamadas :find(..., 1, true), uma em cada direção.
local function mapNameMatchesRecovered(a, b)
    if a == nil or b == nil then
        return false
    end

    local left = normalizeMapNameRecovered(a)
    local right = normalizeMapNameRecovered(b)

    if left == "" or right == "" then
        return false
    end

    if left == right then
        return true
    end

    return left:find(right, 1, true) ~= nil
        or right:find(left, 1, true) ~= nil
end

