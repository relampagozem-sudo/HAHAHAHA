    toggle("Personagem invisível", true, setInvisibleRecovered)
    makeText("Pula Cidade do Bloco, Robloxia Central e Studville. Farma na posição fixa da Cidade de Robloxia.", 48, Color3.fromRGB(22, 44, 70))

    return gui
end

