local function startMapCycleRecovered()
    if cycleWorkerStartedRecovered then return end
    cycleWorkerStartedRecovered = true
    task.spawn(function()
        local state, since, emptySince, lastRequest, sawBoxes = nil, nil, nil, 0, false
        while task.wait(1) do
            if not autoFarmStateRecovered.autoFarmEnabled then
                state, since, emptySince, lastRequest, sawBoxes = nil, nil, nil, 0, false
            else
                local mega = cycleMapIsMegaRecovered()
                local now = tick()
                if state == nil then
                    state, since = mega == true and "mega" or "normal", now
                    sawBoxes = false
                elseif state == "normal" then
                    if mega == true then
                        state, since, emptySince, sawBoxes = "mega", now, nil, false
                    elseif now - since >= 23 and now - lastRequest >= 10 then
                        if RequestTeleport and pcall(requestMega) then
                            state, since, lastRequest = "waitingMega", now, now
                        end
                    end
                elseif state == "waitingMega" then
                    if mega == true or now - since >= 5 then
                        state, since, emptySince, sawBoxes = "mega", now, nil, false
                    end
                elseif state == "mega" then
                    if hasOwnedBoxesRecovered() then
                        sawBoxes, emptySince = true, nil
                    elseif now - since >= 30 then
                        state, lastRequest = "returning", 0
                    end
                elseif state == "draining" then
                    if hasOwnedBoxesRecovered() then
                        state, sawBoxes, emptySince = "mega", true, nil
                    else
                        emptySince = emptySince or now
                        if now - emptySince >= 3 then
                            state, lastRequest = "returning", 0
                        end
                    end
                elseif state == "returning" then
                    if now - lastRequest >= 10 then
                        local callOk, teleported = pcall(requestNormal)
                        if callOk and teleported then
                            state, since, lastRequest = "waitingNormal", now, now
                        end
                    end
                elseif state == "waitingNormal" then
                    if (mega == false and now - since >= 2) or now - since >= 5 then
                        state, since, emptySince, sawBoxes = "normal", now, nil, false
                    end
                end
            end
        end
    end)
end



