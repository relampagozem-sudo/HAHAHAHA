local function readPermissionSwitchesRecovered()
    local observations = {}
    if type(WHITELIST_CONFIG.PERMISSION_URLS) ~= "table" then
        return observations
    end

    for url, expected in pairs(WHITELIST_CONFIG.PERMISSION_URLS) do
        if type(url) == "string" then
            local ok, body = pcall(function() return game:HttpGet(url) end)
            local value = ok and type(body) == "string" and trimRecovered(body) or nil
            table.insert(observations, {
                url = url,
                expected = expected,
                value = value,
                numeric = value and tonumber(value) or nil,
                matchesExpected = value == expected,
            })
        end
    end
    return observations
end

-- Reconstrução do núcleo verificável do proto 86. O kill-switch do proto 68
-- ainda é mantido separado até a direção exata de todos os ramos ser confirmada.
local function checkWhitelistRecovered()
    local player = Players.LocalPlayer
    if not player then
        return false, "Não foi possível obter as informações do jogador"
    end

    local username = player.Name
    local displayName = player.DisplayName

    if type(WHITELIST_CONFIG.LOCAL_USER_IDS) == "table"
        and WHITELIST_CONFIG.LOCAL_USER_IDS[player.UserId]
    then
        return true, " "
    end
    if type(WHITELIST_CONFIG.LOCAL_USERNAMES) == "table"
        and WHITELIST_CONFIG.LOCAL_USERNAMES[username]
    then
        return true, " "
    end

    for _, url in ipairs(buildWhitelistUrlsRecovered()) do
        local data = loadWhitelistDocument(url)
        if usernameAuthorizedRecovered(data, username, displayName) then
            return true, " "
        end
    end

    local userId = tostring(player.UserId)
    local idUrls = {
        WHITELIST_CONFIG.ID_GITHUB_URL,
        WHITELIST_CONFIG.ID_BACKUP_URL,
    }
    for _, url in ipairs(idUrls) do
        if type(url) == "string" and url ~= "" then
            local data = loadWhitelistDocument(url)
            if userIdAuthorizedRecovered(data, userId) then
                return true, " "
            end
        end
    end

    return false, [[Aviso:
O uso deste script é de sua responsabilidade.

Você não está na lista de autorização e não pode usar este script.
Ao solicitar autorização, você aceita estes termos.]]
end

