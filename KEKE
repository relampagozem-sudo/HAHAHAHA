local function canAffordUpgradeRecovered(upgradeName)
    if not config.autoUpgradeNeedAffordCheck then return true end
    local balance = parseDisplayedNumberRecovered(getUpgradeBalanceObjectRecovered())
    local price = parseDisplayedNumberRecovered(getUpgradePriceObject(upgradeName))
    if balance <= 0 or price <= 0 then return false end
    return balance >= price
end
