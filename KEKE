        label.Text = text
        label.Parent = scroll
        return label
    end

    local status = makeText("Status: carregado", 22, Color3.fromRGB(33, 62, 92))

    local function setStatus(message, isError)
        status.Text = "Status: " .. tostring(message)
        status.TextColor3 = isError and Color3.fromRGB(255, 116, 116)
            or Color3.fromRGB(150, 236, 174)
    end

    local function section(text)
        local label = makeText(text, 19, Color3.fromRGB(38, 64, 91))
        label.TextColor3 = Color3.fromRGB(243, 203, 105)
        label.Font = Enum.Font.GothamBold
        return label
    end

    local function toggle(text, initial, callback)
        local enabled = initial and true or false
        local button = Instance.new("TextButton")
        button.Size = UDim2.new(1, -8, 0, 21)
        button.BackgroundColor3 = enabled and Color3.fromRGB(38, 154, 99)
            or Color3.fromRGB(150, 53, 48)
        button.TextColor3 = Color3.new(1, 1, 1)
        button.Font = Enum.Font.GothamBold
        button.TextSize = 9
        button.Parent = scroll

        local function render()
            button.Text = (enabled and "Ligado  " or "Desligado  ") .. text
            button.BackgroundColor3 = enabled and Color3.fromRGB(38, 154, 99)
                or Color3.fromRGB(150, 53, 48)
        end
        render()

        button.MouseButton1Click:Connect(function()
            enabled = not enabled
            render()
            local ok, err = pcall(callback, enabled, button)
            if ok then
                setStatus(text .. (enabled and " ligado" or " desligado"))
            else
                enabled = not enabled
                render()
                setStatus(err, true)
            end
        end)
        return button
    end

    local function numberInput(labelText, value, callback)
        local box = Instance.new("TextBox")
        box.Size = UDim2.new(1, -8, 0, 32)
        box.BackgroundColor3 = Color3.fromRGB(10, 25, 43)
        box.TextColor3 = Color3.fromRGB(236, 236, 236)
        box.PlaceholderText = labelText
        box.Text = labelText .. ": " .. tostring(value)
        box.ClearTextOnFocus = true
        box.Font = Enum.Font.Code
        box.TextSize = 13
        box.Parent = scroll
        box.FocusLost:Connect(function(enterPressed)
            local parsed = tonumber(box.Text)
            if parsed then
                callback(parsed)
                box.Text = labelText .. ": " .. tostring(parsed)
                setStatus(labelText .. " atualizado")
            else
                box.Text = labelText .. ": " .. tostring(value)
                if enterPressed then setStatus("valor inválido", true) end
            end
        end)
        return box
    end

    section("Auto Farm")
    toggle("Farm principal", true, function(enabled)
        setMainAutoRecovered(enabled, {
            log = function(message) setStatus(message) end,
            notify = function(message) setStatus(message) end,
