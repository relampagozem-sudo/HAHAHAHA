-- Linhas ~4140–4149. Duas funções auxiliares do original filtram quando
-- SetCubes deve rodar. Elas continuam expostas por callback porque ainda não
-- há nome seguro para ambas.
local function processSetCubesRecognition(args, mapName, now, notify)
    if not mapName or mapName == "" then
        return
    end

    -- Linhas ~4141: o fluxo chama um helper sem argumentos e depois um
    -- helper com mapName. Os protos 161 e 156 encaixam exatamente nessas
    -- assinaturas e semântica: cache ativo + reconhecimento do nome.
    local gateA
    if args and args.canSetCubes then
        gateA = args.canSetCubes() and true or false
    else
        gateA = hasEnabledSmallMapRecognitionRecovered()
    end

    local gateB
    if args and args.shouldSetCubesForMap then
        gateB = args.shouldSetCubesForMap(mapName) and true or false
    else
        gateB = isRecognizedSmallMapByNameRecovered(mapName)
    end

    if not (gateA and gateB) then
        return
    end

    local repeatedTooSoon =
        teleportRuntime.lastMapName == mapName
        and (now - teleportRuntime.lastMapActionAt) <= MAP_REPEAT_GUARD_SECONDS

    if repeatedTooSoon then
        return
    end

    teleportRuntime.lastMapName = mapName
    teleportRuntime.lastMapActionAt = now

    pcall(args.setCubes or setCubesRecovered)

    local message = "Mapa pequeno reconhecido: " .. mapName .. "; SetCubes executado"
    if args.toast then
        args.toast(message, 2.5)
    end
    if notify then
        notify(message)
    end
end

-- Linhas ~4152–4163.
local function processSkipMap(args, mapName, now, label, notify)
    if not mapName or mapName == "" then
        return false
    end

    -- upvalue13 é a tabela iterada por pairs; upvalue14 é chamada como
    -- matcher(mapName, skipEntry) nas linhas ~4153–4154.
    local skipMaps = args.skipMaps or config.skipMaps
    local matches = args.matchesSkipMap or mapNameMatchesRecovered
    if type(skipMaps) ~= "table" or type(matches) ~= "function" then
        return false
    end

    -- O original usa a chave devolvida por pairs como nome selecionado.
    -- O valor associado nao participa da decisao.
    for selectedMapName in pairs(skipMaps) do
        if matches(mapName, selectedMapName) then
            local allowed =
                teleportRuntime.lastSkipMap ~= mapName
                or (now - teleportRuntime.lastSkipAt) > SKIP_REPEAT_GUARD_SECONDS

            if not allowed then
                return false
            end

            teleportRuntime.lastSkipMap = mapName
            teleportRuntime.lastSkipAt = now

            if label then
                label.Text = "Mapa marcado para pular; trocando..."
            end

            if notify then
                notify("Mapa marcado para pular: " .. mapName .. "; iniciando troca")
            end

            notifyDialog(
                args,
                "Pular mapa",
                "O mapa selecionado " .. tostring(selectedMapName) .. " foi pulado",
                3
            )

            -- Linhas 4161-4163: R58=false, R59=true, depois proto50.
            skipState58 = false
            skipState59 = true
            if args.onSkipState then
                args.onSkipState(false, true)
            end

            if args and args.switchSkippedMap then
                args.switchSkippedMap()
            else
                -- proto50 -> Events.SetServerSettings:FireServer({
                --     MapTime = -1, Paused = true
                -- })
                pcall(forceSwitchMapRecovered)
            end

            return true
        end
    end

    return false
end

local blockedFarmMapRuntime = {
    lastMapName = "",
    lastSwitchAt = 0,
    mapIdentificationStartedAt = tick(),
}

local function isSkippedFarmMapRecovered(mapName)
    if type(mapName) ~= "string" or mapName == "" then return false end
    for selectedMapName in pairs(config.skipMaps or {}) do
        if mapNameMatchesRecovered(mapName, selectedMapName) then
            return true, selectedMapName
        end
    end
    return false
end

-- Usado pelo próprio Heartbeat do farm. A decisão acontece antes de
-- Grab/Eat/SendTrack, portanto nenhum objeto é consumido no mapa bloqueado.
local function suppressFarmOnSkippedMapRecovered(statusLabel, notify)
    local mapName = getCurrentMapNameRecovered()
    if mapName == "" then
        -- Evita comer nos primeiros instantes, antes de MapName aparecer.
        if tick() - (blockedFarmMapRuntime.mapIdentificationStartedAt or tick()) < 5 then
            if statusLabel then statusLabel.Text = "Identificando o mapa..." end
            return true
        end
        return false
    end
    local blocked, selectedName = isSkippedFarmMapRecovered(mapName)
    if not blocked then
        if blockedFarmMapRuntime.lastMapName ~= "" then
            skipState59 = false
        end
        blockedFarmMapRuntime.lastMapName = ""
        return false
    end

    skipState58 = false
    skipState59 = true
    if statusLabel then
        statusLabel.Text = "Mapa ignorado: " .. mapName .. "\nAguardando troca de mapa..."
    end

    local now = tick()
    local maySwitch = blockedFarmMapRuntime.lastMapName ~= mapName
        or (now - blockedFarmMapRuntime.lastSwitchAt) > SKIP_REPEAT_GUARD_SECONDS
    if maySwitch then
        blockedFarmMapRuntime.lastMapName = mapName
        blockedFarmMapRuntime.lastSwitchAt = now
        if notify then
            pcall(notify, "Pulando " .. mapName .. "; o farm foi pausado neste mapa")
        end
        pcall(forceSwitchMapRecovered)
    end
    return true, selectedName
end


-- Proto 215 — classificador Small/Big chamado pelo proto153 na linha ~4170.
-- Correção da V9: proto153 é criado diretamente pelo proto118 em ~4489;
-- portanto não usamos mais a cadeia proto206→proto153 como prova de captures.
local function classifySmallMapRecovered(chunkCount, mapName, isRecognizedSmallMapByName, debugLog)
    chunkCount = tonumber(chunkCount) or 0

    -- A própria string de diagnóstico do original confirma o limiar >= 10.
    if chunkCount >= 10 then
        if debugLog then
            debugLog(
                "[Classificação] blocos="
                .. tostring(chunkCount)
                .. " ≥ 10 → mapa grande"
            )
        end
        return false
    end

    if mapName == nil or mapName == "" then
        if debugLog then
            debugLog(
                "[Classificação] blocos="
                .. tostring(chunkCount)
                .. " nome desconhecido → considerado mapa grande"
            )
        end
        return false
    end

    local recognizer = isRecognizedSmallMapByName
        or isRecognizedSmallMapByNameRecovered

    local isSmall = recognizer(mapName) and true or false

    if debugLog then
        debugLog(
            "[Classificação] blocos="
            .. tostring(chunkCount)
            .. " nome="
            .. tostring(mapName)
            .. " → "
            .. (isSmall and "mapa pequeno" or "mapa grande")
        )
    end

    return isSmall
end

-- Proto 153 linearizado em uma iteração.
local function smartTeleportTick(args)
    -- A cadeia de capturas proto153 -> proto206 -> proto233 -> proto118 resolve
    -- upvalue1 exatamente como registers[26], isto e, Players.LocalPlayer.
    local holder = args.holder or LocalPlayer
    local label = args.label
    local colors = args.colors
    local notify = args.notify

    if not holder then
        return false
    end

    local character = args.character or LocalPlayer.Character
    if not character or not character.Parent then
        if notify then
            notify("Personagem ausente; teleporte pausado")
        end
        return false
    end

    local state = holder:GetAttribute("CountdownState")
    local remaining = tonumber(holder:GetAttribute("RemainingTime")) or 0
    local now = os.clock()

    if teleportRuntime.lastClock == nil then
        teleportRuntime.lastClock = now
    end

    local dt = math.max(0, now - teleportRuntime.lastClock)
    teleportRuntime.lastClock = now

    local mapName = getCurrentMapName(args)

    -- Proto 234 / reconhecimento de mapa.
    processSetCubesRecognition(args, mapName, now, notify)

    -- Skip-map ocorre antes da classificação Small/Mega.
    if processSkipMap(args, mapName, now, label, notify) then
        return true
    end

    -- upvalue21 é o proto215: classifica Small/Big usando primeiro a
    -- quantidade de chunks e, abaixo de 10, o reconhecimento pelo nome.
    local chunkCount = chunkRuntimeRecovered.total
    if args.getChunkCount then
        local ok, value = pcall(args.getChunkCount)
        if ok and value ~= nil then
            chunkCount = tonumber(value) or chunkRuntimeRecovered.total
        end
    end

    local isSmall = classifySmallMapRecovered(
        chunkCount,
        mapName,
        args.isRecognizedSmallMapByName or isRecognizedSmallMapByNameRecovered,
        args.debugMap
    )

    -- Linhas ~4175–4182: máquina de contagem de rodadas.
    if roundState.enabled then
        if isSmall then
            roundState.wasInSmall = true
            roundState.megaMarked = false
        elseif roundState.wasInSmall
            and not roundState.megaMarked
            and teleportRuntime.teleportIssuedAt
            and mapName
            and mapName ~= ""
        then
            markEnterMega()
        end
    end

    -- Linhas ~4188–4197: reconhecimento da chegada à Small.
    if teleportRuntime.teleportIssuedAt
        and state ~= "Small"
        and isSmall
    then
        markRecognizedSmall(holder, label, colors, notify)
        state = "Small"
        remaining = SMALL_COUNTDOWN_SECONDS
    end

    -- Linhas ~4217–4226: watchdog quando o estado continua Small,
    -- o mapa ainda é reconhecido como Small e o contador chegou a zero.
    if teleportRuntime.teleportIssuedAt
        and state == "Small"
        and remaining <= 0
        and isSmall
    then
        if notify then
            notify("Teleporte preso no mapa pequeno; repetindo mapa grande → mapa pequeno")
        end

        notifyDialog(
            args,
            "Teleporte inteligente",
            "Repetindo teleporte: mapa grande → mapa pequeno",
            3
        )

        state = "Mega"
        remaining = MEGA_COUNTDOWN_SECONDS
        setTeleportCountdownState(holder, state, remaining)
        updateTeleportCountdownLabel(label, colors, state, remaining)
        return true
    end

    -- Linhas ~4230–4246: detecta o texto de teleporte preso.
    -- enquanto o mapa já é reconhecido como Small, força TeleportToMegaMap.
    if isSmall
        and label
        and type(label.Text) == "string"
        and string.find(label.Text, "Teleportando para mapa pequeno", 1, true)
    then
        if notify then
        notify("Teleporte travado; forçando mapa pequeno → mapa grande")
        end

        notifyDialog(
            args,
            "Teleporte inteligente",
            "Teleporte travado; forçando mapa pequeno → mapa grande",
            3
        )

        pcall(characterTeleportToMega)

        state = "Mega"
        remaining = MEGA_COUNTDOWN_SECONDS
        setTeleportCountdownState(holder, state, remaining)
        updateTeleportCountdownLabel(label, colors, state, remaining)
        return true
    end

    -- Linhas ~4250–4255: o contador só é decrementado quando há estado,
    -- timestamp de teleporte e remaining > 0.
    if state and teleportRuntime.teleportIssuedAt and remaining > 0 then
        remaining = math.max(0, remaining - dt)
        holder:SetAttribute("RemainingTime", remaining)
    end

    local ceilRemaining = math.ceil(math.max(0, remaining))
    updateTeleportCountdownLabel(label, colors, state, remaining)

    -- Proto 269 é chamado pelo original somente em Mega.
    if state == "Mega"
        and shouldPauseSmartTeleport(state, ceilRemaining)
    then
        if args.setSmartTeleportEnabled then
            args.setSmartTeleportEnabled(false)
        else
            setSmartTeleportRecovered(false, args)
        end
        return false
    end

    -- Linhas ~4269–4280: exatamente em 15 s, uma única vez, salva três
    -- flags e depois desliga as três.
    if state == "Mega"
        and ceilRemaining == SELL_PREP_SECONDS
        and not teleportRuntime.autoStateSaved
    then
        saveAutoFlags(args, notify)

        if notify then
            notify(
                "Contagem do mapa grande: "
                .. tostring(ceilRemaining)
                .. " s; desligando farm automático"
            )
        end
    end

    -- Linhas ~4286 / proto 175: <= 5 s, protegido por flag.
    if state == "Mega"
        and ceilRemaining <= SELL_TRIGGER_SECONDS
        and not teleportRuntime.sellFlowStarted
    then
        teleportRuntime.sellFlowStarted = true
        coroutine.wrap(function()
            runSellFlow(remaining, notify)
        end)()
    end

    -- Linhas ~4341–4361: Small -> Mega.
    if state == "Small" and remaining <= 0 then
        if label then
        label.Text = "Teleportando para mapa grande..."
        end

        if notify then
            notify("Contagem do mapa pequeno encerrada; iniciando teleporte")
        end

        resetChunkState(args, notify)

        state = "Mega"
        remaining = MEGA_COUNTDOWN_SECONDS
        setTeleportCountdownState(holder, state, remaining)

        if notify then
            notify("Mapa grande carregado; contagem de 5500 s iniciada")
        end

        markEnterMega()
        requestMega()
        teleportRuntime.teleportIssuedAt = now
        teleportRuntime.sellFlowStarted = false
        return true
    end

    -- Linhas ~4363–4383: Mega -> Small.
    if state == "Mega" and remaining <= 0 then
        if label then
        label.Text = "Teleportando para mapa pequeno..."
        end

        if notify then
        notify("Contagem do mapa grande encerrada; iniciando teleporte")
        end

        restoreAutoFlags(args, notify)
        resetChunkState(args, notify)

        if not requestNormal() then
            if label then
                label.Text = "Aguardando confirmacao da venda..."
            end
            if notify then
                notify("Venda ainda nao confirmada; teleporte cancelado para proteger o tamanho")
            end
            return true
        end
        teleportRuntime.teleportIssuedAt = now
        teleportRuntime.sellFlowStarted = false
        return true
    end

    -- Linhas ~4388–4413: timeout de 20 s. O original força Normal,
    -- zera os contadores auxiliares e restaura o estado Mega/5500.
    if teleportRuntime.teleportIssuedAt
        and now - teleportRuntime.teleportIssuedAt > TELEPORT_TIMEOUT_SECONDS
    then
        if label then
            label.Text = "Teleporte expirou; forçando mapa pequeno..."
            if colors and colors.TextColor_Error then
                label.TextColor3 = colors.TextColor_Error
            end
        end

        if notify then
            notify("Teleporte expirou após 20 s; forçando teleporte")
        end

        -- Nesse ramo o bytecode confirma pelo menos a restauração da
        -- primeira flag salva antes de limpar o marcador.
        if teleportRuntime.autoStateSaved and teleportRuntime.savedAutoFlags then
            if args.setFirstAutoFlag then
                args.setFirstAutoFlag(teleportRuntime.savedAutoFlags[1])
            elseif args.setAutoFlags then
                args.setAutoFlags(
                    teleportRuntime.savedAutoFlags[1],
                    teleportRuntime.savedAutoFlags[2],
                    teleportRuntime.savedAutoFlags[3]
                )
            end
            teleportRuntime.autoStateSaved = false
            teleportRuntime.savedAutoFlags = nil
        end

        if not requestNormal() then
            if label then
                label.Text = "Aguardando confirmacao da venda..."
            end
            return true
        end
        resetChunkState(args, nil)

        state = "Mega"
        remaining = MEGA_COUNTDOWN_SECONDS
        setTeleportCountdownState(holder, state, remaining)
        updateTeleportCountdownLabel(label, colors, state, remaining)

        -- Linha ~4413 grava um timestamp do ciclo novamente.
        teleportRuntime.teleportIssuedAt = now
        teleportRuntime.sellFlowStarted = false
        return true
    end

    return true
end

