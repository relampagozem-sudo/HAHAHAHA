-- O bytecode resolve os labels de preço por esta hierarquia (proto 9):
-- PlayerGui > ScreenGui > Shop > ShopFrames > Upgrades > UpgradeList
-- > [MaxSize|Speed|EatSpeed|Multiplier] > BuyFrame > Price
local function getUpgradePriceObject(upgradeName)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    local screenGui = playerGui:FindFirstChild("ScreenGui")
    if not screenGui then return nil end

    local shop = screenGui:FindFirstChild("Shop")
    local shopFrames = shop and shop:FindFirstChild("ShopFrames")
    local upgrades = shopFrames and shopFrames:FindFirstChild("Upgrades")
    local list = upgrades and upgrades:FindFirstChild("UpgradeList")
    local row = list and list:FindFirstChild(upgradeName)
    local buyFrame = row and row:FindFirstChild("BuyFrame")
    return buyFrame and buyFrame:FindFirstChild("Price")
end

-- Protos 7/121: parser compartilhado pelo saldo e pelos preços da loja.
local function parseDisplayedNumberRecovered(textObject)
    if not textObject then return 0 end
    local text = tostring(textObject.Text or "")
    if text == "" then return 0 end

    text = text:gsub(",", ""):gsub("%s+", "")
    local lowered = string.lower(text)
    local multiplier = 1
    if lowered:find("k", 1, true) then
        multiplier = 1000
    elseif lowered:find("m", 1, true) then
        multiplier = 1000000
    elseif lowered:find("b", 1, true) then
        multiplier = 1000000000
    elseif text:find("万", 1, true) then
        multiplier = 10000
    elseif text:find("亿", 1, true) then
        multiplier = 100000000
    end

    local number = tonumber(text:gsub("[^%d%.]", "")) or 0
    return math.floor(number * multiplier)
end

