-- Já foram recuperadas as peças: Upgrades.MaxSize.Value, math.cos/sin, Position,
-- Size/HipHeight, reconhecimento de mapa, teleport cronometrado, stuck-respawn
-- e atualização de status. A fórmula circular de movimento já foi linearizada.
-- Linhas ~1985, ~1986 e ~1988 do proto 133.
-- As três closures chamadas por pcall foram identificadas:
--   proto 259 -> Grab:FireServer()
--   proto 198 -> Eat:FireServer()
--   proto 178 -> SendTrack:FireServer()
-- O fluxo do proto133 fecha esta ordem a cada Heartbeat: Grab e Eat são
-- incondicionais; SendTrack só roda quando o remote capturado em U25 existe.
local function fireFarmRemotesRecovered(bindings)
    if not bindings then return end
    if sellTransitionPhaseRecovered then
        -- Durante draining, conclui somente o bloco atual. Sem Grab, nenhum
        -- bloco novo pode iniciar. Durante selling, nenhum remote de farm roda.
        if sellTransitionPhaseRecovered == "draining" and bindings.Eat then
            pcall(function() bindings.Eat:FireServer() end)
        end
        return
    end
    if bindings.Grab then
        pcall(function() bindings.Grab:FireServer() end)
    end
    if bindings.Eat then
        pcall(function() bindings.Eat:FireServer() end)
    end
    if bindings.SendTrack then
        pcall(function() bindings.SendTrack:FireServer() end)
    end
end

-- Proto 133, linhas-fonte ~1895–1905 e ~2092.
-- Este bloco agora pôde ser linearizado quase por completo.
-- O Heartbeat recebe `dt` em registers[1]. O estado angular fica em um
-- upvalue persistente e é atualizado por Size.Value / LocalPlayer.Upgrades.MaxSize.Value.
local orbitStateRecovered = {
    phase = 0,
}

local function getLocalUpgradesRecovered()
    return LocalPlayer and LocalPlayer:FindFirstChild("Upgrades")
end

local function computeOrbitPositionRecovered(bindings, farmPlatform, dt)
    if not bindings or not bindings.humanoid or not bindings.root or not bindings.sizeValue then
        return nil
    end
    local upgrades = getLocalUpgradesRecovered()
    local maxSizeObj = upgrades and upgrades:FindFirstChild("MaxSize")
    local maxSize = maxSizeObj and tonumber(maxSizeObj.Value) or nil
    if not maxSize or maxSize == 0 then
        return nil
    end

    -- L1895: phase += (Size.Value / Upgrades.MaxSize.Value) * dt
    orbitStateRecovered.phase = orbitStateRecovered.phase
        + ((tonumber(bindings.sizeValue.Value) or 0) / maxSize) * (tonumber(dt) or 0)

    -- L1896
    orbitStateRecovered.phase = orbitStateRecovered.phase % 65536

    -- L1897–1899. O bytecode calcula um raio serrilhado 0..128 a partir da fase
    -- e usa a própria fase como argumento de cos/sin.
    local radius = (-orbitStateRecovered.phase * math.pi) % 128
    local x = math.cos(orbitStateRecovered.phase) * radius
    local z = math.sin(orbitStateRecovered.phase) * radius

    -- L1901: topo da plataforma = Position.Y + Size.Y / 2.
    local baseY = 0
    if farmPlatform then
        baseY = farmPlatform.Position.Y + (farmPlatform.Size.Y / 2)
    end

    -- L1904–1905: HipHeight + metade da altura do Root + offset literal 5.
    local hipHeight = bindings.humanoid and bindings.humanoid.HipHeight or 0
    local rootHalfY = bindings.root and (bindings.root.Size.Y / 2) or 2.5
    local y = baseY + hipHeight + rootHalfY + 5

    return x, y, z
end

-- L2092: CFrame.new(x,y,z) * CFrame.Angles(0, atan2(x,z)+pi, 0)
local function buildMovementFrameRecovered(x, y, z)
    return CFrame.new(x, y, z)
        * CFrame.Angles(0, math.atan2(x, z) + math.pi, 0)
end

local function applyRecoveredMovement(bindings, farmPlatform, dt)
    if not bindings or not bindings.root or not bindings.humanoid then return false end

    local baseY = 0
    if farmPlatform then
        baseY = farmPlatform.Position.Y + (farmPlatform.Size.Y / 2)
    end
    local y = baseY + bindings.humanoid.HipHeight + (bindings.root.Size.Y / 2) + 5

    -- Com U37/R42=false, o original escolhe um dos dois pares fixos. Esse é
    -- o modo normal de comer parado mostrado pelo usuário.
    if not circularMovementRecovered then
        local x
        local z
        local mode
        if skipState58 then
            x = tonumber(config.teleportPosX) or teleportPosX
            z = tonumber(config.teleportPosZ) or teleportPosZ
            mode = "timed-teleport"
        else
            local mapName = getCurrentMapNameRecovered()
            if isRobloxiaCityFarmMapRecovered(mapName) then
                specialFarmPositionRuntime.mapName = mapName
                specialFarmPositionRuntime.x = ROBLOXIA_CITY_FARM_POSITION.X
                specialFarmPositionRuntime.z = ROBLOXIA_CITY_FARM_POSITION.Z
                x = ROBLOXIA_CITY_FARM_POSITION.X
                y = ROBLOXIA_CITY_FARM_POSITION.Y
                z = ROBLOXIA_CITY_FARM_POSITION.Z
                mode = "robloxia-city-fixed-position"
            else
                x = tonumber(config.idlePosX) or idlePosX
                z = tonumber(config.idlePosZ) or idlePosZ
                mode = "fixed-farm"
            end
        end
        bindings.root.CFrame = CFrame.new(x, y, z)
        return true, x, y, z, mode
    end

    local x, orbitY, z = computeOrbitPositionRecovered(bindings, farmPlatform, dt)
    if x == nil then return false end
    y = orbitY

    -- Proto133 U4 = célula compartilhada R58. Depois do disparo temporizado,
    -- as linhas 2094-2096 mantêm a posição fixa configurada.
    if skipState58 then
        x = tonumber(config.teleportPosX) or teleportPosX
        z = tonumber(config.teleportPosZ) or teleportPosZ
        bindings.root.CFrame = CFrame.new(x, y, z)
        return true, x, y, z, "timed-teleport"
    end

    bindings.root.CFrame = buildMovementFrameRecovered(x, y, z)
    return true, x, y, z, "circular"
end

