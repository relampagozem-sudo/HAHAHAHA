    applyPlayerCollisionGroupRecovered(character)
    b.humanoid:ChangeState(Enum.HumanoidStateType.Running)

    if heartbeatConnection then
        heartbeatConnection:Disconnect()
        heartbeatConnection = nil
    end

    heartbeatConnection = RunService.Heartbeat:Connect(function(dt)
        -- Proto 133 inicia com guardas para Humanoid / Root / Size.
        if not b.humanoid or not b.root or not b.sizeValue then return end
        if suppressFarmOnSkippedMapRecovered(nil, nil) then return end

        -- L1895–1905 + L2092.
        local _, _, movementY = applyRecoveredMovement(b, activeFarmPlatformRecovered, dt)
        timedTeleportHeartbeat(
            b,
            tick() - heartbeatRuntime.mapStartedAt,
            movementY,
            nil,
            notifyDialogRecovered
        )

        -- L1985: Grab; L1986: Eat; L1988: SendTrack somente se existir.
        -- Esses três blocos estão dentro de pcall no original.
        fireFarmRemotesRecovered(b)
        updateChunkCounterRecovered(b.CurrentChunk, dt)
        processAutoSellRecovered(b)

        -- L2026–2035.
        stuckRespawnHeartbeat(b)
    end)

    b.humanoid.Died:Connect(function()
        -- O original limpa/reagenda estado de personagem e reconecta a lógica.
    end)
end

