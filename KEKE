-- Proto 157: espera o Humanoid tocar o chão. Timeout confirmado em 5 s.
-- O proto157 é a rotina de espera por aterrissagem usada pelo subsistema de teleporte.
local function waitForLanding(character, notify)
    if not character then return false end

    local humanoid = character:WaitForChild("Humanoid")
    local started = os.clock()

    while humanoid.FloorMaterial == Enum.Material.Air do
        if os.clock() - started > LANDING_TIMEOUT_SECONDS then
            if notify then
                notify("Tempo de espera do personagem esgotado; monitor de teleporte iniciado")
            end
            return false
        end
        task.wait(0.1)
    end

    if notify then
        notify("Personagem no chão; monitor de teleporte iniciado")
    end
    return true
end

local function markRecognizedSmall(holder, label, colors, notify)
