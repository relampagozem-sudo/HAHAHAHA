    roundState.wasInSmall = true
    roundState.megaMarked = false
    updateTeleportCountdownLabel(label, colors, "Small", SMALL_COUNTDOWN_SECONDS)

    if notify then
        notify("Mapa pequeno reconhecido; contagem de 10 s iniciada")
    end
end

local function beginMegaCountdown(holder, label, colors)
