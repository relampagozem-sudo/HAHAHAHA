local data = [[

]]
local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
data = data:gsub("%s+", "")
local lookup = {}
for i = 1, #alphabet do lookup[alphabet:byte(i)] = i - 1 end
local output, count = {}, 0
for i = 1, #data, 4 do
    local a, b, c, d = data:byte(i, i + 3)
    if a and b and lookup[a] and lookup[b] then
        local value = lookup[a] * 262144 + lookup[b] * 4096
        if c and c ~= 61 then value = value + lookup[c] * 64 end
        if d and d ~= 61 then value = value + lookup[d] end
        count = count + 1; output[count] = string.char(math.floor(value / 65536) % 256)
        if c and c ~= 61 then
            count = count + 1; output[count] = string.char(math.floor(value / 256) % 256)
        end
        if d and d ~= 61 then
            count = count + 1; output[count] = string.char(value % 256)
        end
    end
end
for i = 1, count do
    output[i] = string.char((output[i]:byte() - 137 - ((i - 1) % 251)) % 256)
end
local compile = loadstring or load
assert(compile, "Este executor precisa oferecer loadstring")
local run, err = compile(table.concat(output))
assert(run, err)
return run()
