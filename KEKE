    updateTeleportCountdownLabel(label, colors, "Mega", MEGA_COUNTDOWN_SECONDS)
end

-- Proto 179 + proto 142. O fluxo externo (proto 175) espera 1 s antes e
-- depois da tentativa principal.
local function sellRecovered(notify)
    local ok, err = pcall(function()
        local character = LocalPlayer.Character
        local charEvents = character and character:FindFirstChild("Events")
        local sell = charEvents and charEvents:FindFirstChild("Sell")

        if sell then
            sell:FireServer()
            return
        end

        -- O proto 179 contém uma segunda rota para o Sell.
        local fallback = Events and Events:FindFirstChild("Sell")
        if fallback then
            fallback:FireServer()
            return
        end

        error("Sell remote not found")
    end)

    if ok then
        if notify then notify("Venda concluída") end
        return true
    end

    if notify then
        notify("Falha na venda: " .. tostring(err))
    end

    local backupOk = pcall(function()
        local character = LocalPlayer.Character
        if character
            and character:FindFirstChild("Events")
            and character.Events:FindFirstChild("Sell")
        then
            character.Events.Sell:FireServer()
        end
    end)

    if backupOk and notify then
        notify("Venda alternativa concluída")
    end

    return backupOk
end

-- Proto 175, linhas ~4290–4334.
local function runSellFlow(remaining, notify)
    if notify then
        notify("Contagem do mapa grande: " .. tostring(math.ceil(remaining)) .. " s; iniciando venda")
    end

    task.wait(1)
    sellRecovered(notify)
    task.wait(1)

    teleportRuntime.sellFlowStarted = false
end

-- Declarações antecipadas: o proto153 usa estas funções antes da seção em
-- que o estado de 刷/领/收 é reconstruído. Sem isso, Luau buscaria globais.
local getAutoFarmFlagsRecovered
local setAutoFarmFlagsRecovered

-- As três flags de auto刷/领/收 aparecem como três upvalues booleanos
-- independentes. Os nomes individuais ainda não estão seguros.
local function saveAutoFlags(args, notify)
    if teleportRuntime.autoStateSaved then
        return
    end

    local a, b, c
    if args and args.getAutoFlags then
        a, b, c = args.getAutoFlags()
    else
        a, b, c = getAutoFarmFlagsRecovered()
    end

    teleportRuntime.savedAutoFlags = {a, b, c}
    teleportRuntime.autoStateSaved = true

    if notify then
        notify("Mapa grande em 15 s; estado do farm automático salvo")
    end

    if args and args.setAutoFlags then
        args.setAutoFlags(false, false, false)
    else
        setAutoFarmFlagsRecovered(false, false, false)
    end
end

local function restoreAutoFlags(args, notify)
    if not teleportRuntime.autoStateSaved then
        return
    end

    local saved = teleportRuntime.savedAutoFlags
    if saved then
        if args and args.setAutoFlags then
            args.setAutoFlags(saved[1], saved[2], saved[3])
        else
            setAutoFarmFlagsRecovered(saved[1], saved[2], saved[3])
        end
    end

    teleportRuntime.autoStateSaved = false
    teleportRuntime.savedAutoFlags = nil

    if notify then
        notify("Farm, recompensas e coleta restaurados")
    end
end

