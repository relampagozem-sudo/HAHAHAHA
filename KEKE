local function updateTeleportCountdownLabel(label, colors, state, remaining)
    if not label then return end

    remaining = math.max(0, tonumber(remaining) or 0)
    local seconds = math.ceil(remaining)

    if state == "Mega" then
        if colors and colors.TextColor_MegaToSmall then
            label.TextColor3 = colors.TextColor_MegaToSmall
        end
        label.Text = "Mapa grande → mapa pequeno: " .. tostring(seconds) .. " s"
    elseif state == "Small" then
        if colors and colors.TextColor_SmallToMega then
            label.TextColor3 = colors.TextColor_SmallToMega
        end
        label.Text = "Mapa pequeno → mapa grande: " .. tostring(seconds) .. " s"
    end
