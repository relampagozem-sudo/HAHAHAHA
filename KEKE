local cycleWorkerStartedRecovered = false

local function readCycleMapNameRecovered()
    local name = getCurrentMapNameRecovered()
    if name ~= "" then return name end
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local screenGui = playerGui and playerGui:FindFirstChild("ScreenGui")
    if not screenGui then return "" end
    for _, item in ipairs(screenGui:GetDescendants()) do
        if item:IsA("TextLabel") and item.Visible then
            local shown = tostring(item.Text or "")
            local normalized = normalizeMapNameRecovered(shown)
            if normalized == "cidadederobloxia" or normalized == "robloxiacity"
                or normalized == "mega" or normalized == "megabaseplate"
                or normalized == "baseplate" then
                return shown
            end
        end
    end
    return ""
end

local function cycleMapIsMegaRecovered()
    local name = normalizeMapNameRecovered(readCycleMapNameRecovered())
    if name == "" then return nil end
    return name:find("mega", 1, true) ~= nil
        or name == "baseplate" or name == "placabase"
