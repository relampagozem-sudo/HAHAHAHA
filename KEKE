local heartbeatRuntime = {
    lastTimedTeleportAt = 0,
    mapStartedAt = tick(),
    timedTeleportTriggered = false,
    lastSize = nil,
    lastSizeChangeAt = tick(),
    previousMapElapsedSeconds = 0,
    lastStatusUpdateAt = 0,
}

local function updateChunkCounterRecovered(currentChunk, dt)
    -- Proto133 linhas 1990-2004: conta a borda false -> true e mantém U30,
    -- o tempo contínuo sem CurrentChunk ativo.
    local active = false
    if currentChunk and currentChunk.Parent then
        local ok, value = pcall(function()
            return currentChunk.Value
        end)
        if ok then active = value and true or false end
    end

    if active and not chunkRuntimeRecovered.previousActive then
        chunkRuntimeRecovered.total += 1
    end
    chunkRuntimeRecovered.previousActive = active

    if active then
        chunkRuntimeRecovered.noChunkSeconds = 0
    else
        chunkRuntimeRecovered.noChunkSeconds += math.max(0, tonumber(dt) or 0)
    end

    return chunkRuntimeRecovered.total, chunkRuntimeRecovered.noChunkSeconds
end

local function finishSellTransitionRecovered(delaySeconds)
    task.wait(delaySeconds)
    -- Protos 242 (8 s) e 176 (3 s) terminam restaurando o estado,
    -- chamando proto50/SetServerSettings e soltando o debounce.
    local elapsed = math.max(0, tick() - heartbeatRuntime.mapStartedAt)
    -- Protos 176/242 só preservam o intervalo anterior quando ele alcança 60 s.
    if elapsed >= 60 then
        heartbeatRuntime.previousMapElapsedSeconds = elapsed
    end
    pcall(forceSwitchMapRecovered)
    skipState58 = false
    heartbeatRuntime.timedTeleportTriggered = false
    heartbeatRuntime.mapStartedAt = tick()
    blockedFarmMapRuntime.mapIdentificationStartedAt = tick()
    specialFarmPositionRuntime.mapName = ""
    specialFarmPositionRuntime.x = nil
    specialFarmPositionRuntime.z = nil
    chunkRuntimeRecovered.sellDebounce = false
end

local function processAutoSellRecovered(bindings)
    if not bindings or not bindings.sizeValue or not bindings.Sell then return false end
    if sellTransitionPhaseRecovered then return false end

    local upgrades = getLocalUpgradesRecovered()
    local maxSizeObject = upgrades and upgrades:FindFirstChild("MaxSize")
    local currentSize = tonumber(bindings.sizeValue.Value)
    local maxSize = maxSizeObject and tonumber(maxSizeObject.Value) or nil
    if not currentSize or not maxSize then return false end

    local noChunkSeconds = chunkRuntimeRecovered.noChunkSeconds
    -- Proto133 PCs 497–498/593–595: MaxSize <= Size + 2.
    local capacityReached = maxSize <= currentSize + 2
    if not capacityReached and noChunkSeconds <= 12 then
        return false
    end

    -- Proto149 (capacidade) e proto166 (timeout) chamam o mesmo Sell sem args.
    pcall(function() bindings.Sell:FireServer() end)
    chunkRuntimeRecovered.total = 0

    if not chunkRuntimeRecovered.sellDebounce then
        chunkRuntimeRecovered.sellDebounce = true
        local delaySeconds = noChunkSeconds < 12 and 8 or 3
        task.spawn(finishSellTransitionRecovered, delaySeconds)
    end
    return true
end

-- Proto 133, linhas 1889–1959: utilitários de status recuperados.
local STATUS_FORMAT_RECOVERED = table.concat({
    "Executando...",
    "Tempo em execução: %ih%im%is",
    "Tempo efetivo: %im%is",
    "Rendimento diário: %s",
    "Mapa anterior: %im%is",
    "Mapa atual: %im%is",
    "Total de blocos: %i",
}, "\n")

local function splitMSRecovered(seconds)
    seconds = math.max(0, tonumber(seconds) or 0)
    return math.floor(seconds / 60), math.floor(seconds) % 60
end

local function splitHMSRecovered(seconds)
    seconds = math.max(0, tonumber(seconds) or 0)
    return math.floor(seconds / 3600), math.floor(seconds / 60) % 60, math.floor(seconds) % 60
end

local function formatDailyIncomeRecovered(value)
    value = tonumber(value) or 0
    if value >= 100000000 then
        return string.format("%.2f milhões", value / 1000000)
    elseif value >= 10000 then
        return string.format("%.2f mil", value / 1000)
    end
    return tostring(value)
end

local function buildStatusTextRecovered(args)
    args = args or {}
    local rh, rm, rs = splitHMSRecovered(args.runElapsedSeconds)
    local am, as = splitMSRecovered(args.actualElapsedSeconds)
    local pm, ps = splitMSRecovered(args.previousMapElapsedSeconds)
    local cm, cs = splitMSRecovered(args.currentMapElapsedSeconds)
    local daily = args.dailyIncomeText or formatDailyIncomeRecovered(args.dailyIncome or 0)
    return string.format(STATUS_FORMAT_RECOVERED, rh, rm, rs, am, as, daily, pm, ps, cm, cs, math.floor(tonumber(args.totalChunks) or 0))
end

-- Proto53 / linha 1602: PCs 2–4 fazem +0.5, potência 2 e -0.25;
-- PCs 47–48 completam /2 e *100 antes de math.floor.
local function sizeMetricRecovered(value)
    return math.floor((((value + 0.5) ^ 2 - 0.25) / 2) * 100)
end

-- Proto 133, linhas 1906–1919, agora sem callback/desconhecido.
local function computeDailyIncomeRecovered()
    local upgrades = LocalPlayer and LocalPlayer:FindFirstChild("Upgrades")
    if not upgrades then return nil end
    local multi = upgrades:FindFirstChild("Multiplier")
    local maxSize = upgrades:FindFirstChild("MaxSize")
    if not multi or not maxSize then return nil end

    local multiplierScale = multi.Value / 100
    if multiplierScale == 0 then return nil end

    local normalizedMax = maxSize.Value / multiplierScale
    local halfNormalizedMax = normalizedMax / 2
    if halfNormalizedMax == 0 then return nil end

    local metric = sizeMetricRecovered(maxSize.Value)
    local perSecond = math.floor(metric / halfNormalizedMax)
    local daily = perSecond * 60 * 60 * 24
    return daily, formatDailyIncomeRecovered(daily)
end

-- O formato e os cálculos já estavam recuperados, mas a V22 não os ligava ao
-- TextLabel. Atualiza quatro vezes por segundo para não pesar no Heartbeat.
local function updateAutoFarmStatusRecovered(statusLabel)
    if not statusLabel or not statusLabel.Parent then return false end
    local now = tick()
    if now - (heartbeatRuntime.lastStatusUpdateAt or 0) < 0.25 then return false end
    heartbeatRuntime.lastStatusUpdateAt = now

    local startedAt = tonumber(autoFarmStateRecovered.startedAt) or now
    local mapStartedAt = tonumber(heartbeatRuntime.mapStartedAt) or now
    local daily, dailyText = computeDailyIncomeRecovered()
    statusLabel.Text = buildStatusTextRecovered({
        runElapsedSeconds = now - startedAt,
        actualElapsedSeconds = now - startedAt,
        dailyIncome = daily or 0,
        dailyIncomeText = dailyText,
        previousMapElapsedSeconds = heartbeatRuntime.previousMapElapsedSeconds or 0,
        currentMapElapsedSeconds = now - mapStartedAt,
        totalChunks = chunkRuntimeRecovered.total,
    })
    return true
end

-- Proto 133 linhas ~1926–1937. O Y usado pelo original é calculado em outro
-- bloco; recebe targetY para não inventar a fórmula.
local function timedTeleportHeartbeat(bindings, mapElapsedSeconds, targetY, notify, detailedNotify)
    if not bindings or not bindings.root or not config.timedTeleportEnabled then return false end
    if heartbeatRuntime.timedTeleportTriggered then return false end

    local thresholdSeconds = tonumber(config.teleportMinutes) or 240
    if thresholdSeconds <= 0 then return false end
    if (tonumber(mapElapsedSeconds) or 0) < thresholdSeconds then return false end

    local x = tonumber(config.teleportPosX) or -260
    local z = tonumber(config.teleportPosZ) or 800
    targetY = tonumber(targetY) or bindings.root.Position.Y
    bindings.root.CFrame = CFrame.new(x, targetY, z)

    heartbeatRuntime.timedTeleportTriggered = true
    heartbeatRuntime.lastTimedTeleportAt = tick()
    skipState58 = true

    local message = string.format(
        "Teleporte temporizado: mapa atual atingiu %.0f s; indo para (%.0f, %.0f)",
        thresholdSeconds, x, z
    )
    if notify then pcall(notify, message) end
    if detailedNotify then pcall(detailedNotify, "Teleporte temporizado", message, 4) end
    return true, message
end

-- Proto 133 linhas ~2026–2035.
local function stuckRespawnHeartbeat(bindings, notify)
    if not bindings or not bindings.humanoid or not bindings.sizeValue then return false end

    local current = bindings.sizeValue.Value
    if not config.stuckRespawnEnabled then
        heartbeatRuntime.lastSize = current
        heartbeatRuntime.lastSizeChangeAt = tick()
        return false
    end

    if heartbeatRuntime.lastSize == nil or current ~= heartbeatRuntime.lastSize then
        heartbeatRuntime.lastSize = current
        heartbeatRuntime.lastSizeChangeAt = tick()
        return false
    end

    local limit = tonumber(config.stuckRespawnSeconds) or 60
    local unchangedFor = tick() - heartbeatRuntime.lastSizeChangeAt
    if unchangedFor <= limit then return false end

    if notify then
        notify("Tamanho do personagem sem aumentar por " .. tostring(math.floor(unchangedFor)) .. " s; personagem reiniciado automaticamente")
    end
    pcall(function() bindings.humanoid.Health = 0 end)
    heartbeatRuntime.lastSizeChangeAt = tick()
    return true
end

