local function normalizeMapNameRecovered(value)
    local normalized = string.lower(tostring(value))
    normalized = normalized:gsub("^%s+", "")
    normalized = normalized:gsub("%s+$", "")
    normalized = normalized:gsub("[%p%s_%-]", "")
