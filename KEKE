-- LocalPlayer:FindFirstChild("TimedRewards"), os.time(), ipairs(GetChildren()),
-- tonumber(child.Value), RewardEvent:FireServer(<1 argumento>), wait(0.1),
-- e SpinEvent:FireServer(...).
--
-- V14: o argumento foi fechado pela sequência 45–48 do proto224:
-- registers[9] recebe registers[5], que é o objeto `reward` da iteração.
local function claimTimedRewardsPassRecovered()
    local timedRewards = LocalPlayer:FindFirstChild("TimedRewards")
    if not timedRewards then
        return false
    end

    local now = os.time()
    local rewardEvent = Events and Events:FindFirstChild("RewardEvent")

    for _, reward in ipairs(timedRewards:GetChildren()) do
        local unlockAt = tonumber(reward.Value)
        if unlockAt and unlockAt > 0 and now >= unlockAt and rewardEvent then
            rewardEvent:FireServer(reward)
            task.wait(0.1)
        end
    end

    local spinEvent = Events and Events:FindFirstChild("SpinEvent")
    if spinEvent then
        -- A chamada existe no bytecode; nenhum argumento é atribuído sem prova.
        spinEvent:FireServer()
    end
    return true
end

