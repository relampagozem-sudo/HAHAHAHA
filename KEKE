        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -8, 0, height or 27)
        label.BackgroundColor3 = color or Color3.fromRGB(27, 51, 80)
        label.TextColor3 = Color3.fromRGB(235, 239, 244)
        label.Font = Enum.Font.Gotham
        label.TextSize = 9
