    if value <= 0 then
        return false, "Meta de rodadas inválida; informe um número inteiro maior que zero"
    end
    roundState.target = value
    roundState.pauseTriggered = false
    config.roundTarget = value
    saveConfigRecovered()
    return true
end

local function setRoundControl(enabled)
    roundState.enabled = enabled
    config.roundControlEnabled = enabled
    saveConfigRecovered()
end

local setSmartTeleportRecovered

-- Proto 269. A pausa ocorre quando count >= target e o countdown do Mega
-- chega ao pauseRemaining (5432). O prototipo chama o setter real com false.
local function shouldPauseSmartTeleport(countdownState, remainingTime)
    if not roundState.enabled or roundState.pauseTriggered then return false end
    if roundState.count < roundState.target then return false end
    if countdownState ~= "Mega" then return false end
    if remainingTime > roundState.pauseRemaining then return false end

    roundState.pauseTriggered = true
    return true
end

------------------------------------------------------------------------
-- TELEPORTE INTELIGENTE — PROTO 153/157/175/179/233/234 (V2)
--
-- Esta versão foi relida em ordem de linha-fonte. Partes confirmadas pelo
-- bytecode são mantidas diretamente; auxiliares cujo nome exato ainda não
-- foi recuperado entram como callbacks em `args`, em vez de serem inventados.
------------------------------------------------------------------------

local function requestMega()
    if RequestTeleport then
        RequestTeleport:FireServer("Mega")
    end
end

-- Fases da saida do Mega:
--   "draining": bloqueia Grab, mas mantém Eat para terminar o bloco atual.
--   "selling": bloqueia Grab e Eat enquanto vende e confirma o resultado.
local sellTransitionPhaseRecovered = nil

-- Protecao central do retorno: o mapa Normal so e solicitado depois que o
-- servidor confirmar a venda pela reducao de Character.Size.
local function sellBeforeNormalRecovered()
    if sellTransitionPhaseRecovered then
        return false
    end

    sellTransitionPhaseRecovered = "draining"

    local character = LocalPlayer.Character
    local charEvents = character and character:FindFirstChild("Events")
    local sell = charEvents and charEvents:FindFirstChild("Sell")
    local sizeValue = character and character:FindFirstChild("Size")
    local currentChunk = character and character:FindFirstChild("CurrentChunk")

    if not sell and Events then
        sell = Events:FindFirstChild("Sell")
    end

    if not sell or not sizeValue then
        warn("[ETW V32] Sell ou Size nao encontrado antes do retorno ao mapa normal")
        sellTransitionPhaseRecovered = nil
        return false
    end

    local sizeBefore = tonumber(sizeValue.Value) or 0
    if sizeBefore <= 0 then
        sellTransitionPhaseRecovered = nil
        return true
    end

    -- Nao pega outro bloco, mas continua enviando Eat ate o bloco que ja estava
    -- em andamento terminar. Depois de CurrentChunk livre, bloqueia Eat também.
    local drainDeadline = tick() + 25
    local idleSince = nil

    while tick() < drainDeadline do
        if not character.Parent or not sizeValue.Parent then
            sellTransitionPhaseRecovered = nil
            return false
        end

        local chunkActive = false
        if currentChunk and currentChunk.Parent then
            local readOk, value = pcall(function()
                return currentChunk.Value
            end)
            chunkActive = readOk and value and true or false
        end

        if chunkActive then
            idleSince = nil
        else
            idleSince = idleSince or tick()
            if tick() - idleSince >= 0.75 then
                break
            end
        end

        task.wait(0.1)
    end

    if not idleSince or tick() - idleSince < 0.75 then
        warn("[ETW V32] Coleta nao terminou; venda e retorno adiados")
        sellTransitionPhaseRecovered = nil
        return false
    end

    sellTransitionPhaseRecovered = "selling"
    task.wait(0.25)

    local deadline = tick() + 8
    local nextAttempt = 0

    while tick() < deadline do
        if not character.Parent or not sizeValue.Parent then
            sellTransitionPhaseRecovered = nil
            return false
        end

        local currentSize = tonumber(sizeValue.Value) or sizeBefore
        if currentSize < sizeBefore then
            -- Uma pausa curta evita que o teleporte dispute o mesmo frame da
            -- atualizacao de saldo/tamanho recebida do servidor.
            task.wait(0.35)
            sellTransitionPhaseRecovered = nil
            return true
        end

        if tick() >= nextAttempt then
            local ok, err = pcall(function()
                sell:FireServer()
            end)
            if not ok then
                warn("[ETW V32] Falha ao vender antes do retorno: " .. tostring(err))
            end
            nextAttempt = tick() + 1
        end

        task.wait(0.1)
    end

    warn("[ETW V32] Venda nao confirmada; retorno ao mapa normal cancelado")
    sellTransitionPhaseRecovered = nil
    return false
end

local function requestNormal()
    if not sellBeforeNormalRecovered() then return false end
    if not RequestTeleport then return false end

    RequestTeleport:FireServer("Normal")
    return true
end

