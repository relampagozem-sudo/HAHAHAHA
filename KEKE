local function trimRecovered(s)
    if type(s) ~= "string" then return s end
    return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

-- Proto 12: baixa o conteúdo e tenta interpretar .lua/.json.
-- A ordem exata dos fallbacks ainda está sendo validada, mas HttpGet,
-- loadstring e HttpService:JSONDecode aparecem diretamente no bytecode.
local function loadWhitelistDocument(url)
    if type(url) ~= "string" or url == "" then return nil end

    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)
    if not ok or type(body) ~= "string" then return nil end

    local lower = string.lower(url)
    if string.find(lower, "%.lua") then
        local okLua, result = pcall(function()
            local fn = loadstring(body)
            if not fn then error("Não foi possível interpretar o código Lua") end
            return fn()
        end)
        if okLua then return result end
    end

    if string.find(lower, "%.json") then
        local okJson, result = pcall(function()
            return HttpService:JSONDecode(body)
        end)
        if okJson then return result end
    end

    -- O original possui fallbacks para conteúdo sem extensão reconhecida.
    local okLua, luaResult = pcall(function()
        local fn = loadstring(body)
        return fn and fn()
    end)
    if okLua and luaResult ~= nil then return luaResult end

    local okJson, jsonResult = pcall(function()
        return HttpService:JSONDecode(body)
    end)
    if okJson then return jsonResult end

    return nil
end

