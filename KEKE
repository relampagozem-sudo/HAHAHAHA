-- Proto246 linearizado no nível de ciclo de vida.
local function runMainAutoFarmLifecycleRecovered(notify, lifecycleGeneration)
    autoFarmStateRecovered.lifecycleRunning = true
    local statusGui, statusLabel = createAutoFarmStatusGuiRecovered()
    local platform = createFarmPlatformRecovered()
    activeFarmPlatformRecovered = platform

    local map, chunks = hideWorldMapForFarmRecovered()

    local function attachCurrent(character)
        task.spawn(function()
            if not autoFarmStateRecovered.autoFarmEnabled
                or autoFarmStateRecovered.lifecycleGeneration ~= lifecycleGeneration then
                return
            end
            attachCharacterLifecycleRecovered(character, statusLabel, notify)
        end)
    end

    if LocalPlayer.Character then
        attachCurrent(LocalPlayer.Character)
    else
        -- CharacterAdded:Wait() prendia a rotina mesmo depois de desligar.
        while not LocalPlayer.Character
            and autoFarmStateRecovered.autoFarmEnabled
            and autoFarmStateRecovered.lifecycleGeneration == lifecycleGeneration do
            task.wait()
        end
        if LocalPlayer.Character then
            attachCurrent(LocalPlayer.Character)
        end
    end

    local characterConnection = LocalPlayer.CharacterAdded:Connect(attachCurrent)

    while autoFarmStateRecovered.autoFarmEnabled
        and autoFarmStateRecovered.lifecycleGeneration == lifecycleGeneration do
        task.wait()

        local loading = workspace:FindFirstChild("Loading")
        if loading then
            pcall(function() loading:Destroy() end)
        end

        if map then map.Parent = nil end
        if chunks then chunks.Parent = nil end
    end

    if characterConnection then
        pcall(function() characterConnection:Disconnect() end)
    end
    if heartbeatConnection then
        pcall(function() heartbeatConnection:Disconnect() end)
        heartbeatConnection = nil
    end
    if characterDiedConnectionRecovered then
        pcall(function() characterDiedConnectionRecovered:Disconnect() end)
        characterDiedConnectionRecovered = nil
    end

    restoreWorldMapAfterFarmRecovered(map, chunks)

    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
            pcall(function()
                humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
        end
        setCharacterLocalScriptsRecovered(character, true)
    end

    if notify then
        pcall(notify, "Farm automático desligado; contagem de blocos preservada")
    end

    if statusGui then pcall(function() statusGui:Destroy() end) end
    if platform then pcall(function() platform:Destroy() end) end
    if activeFarmPlatformRecovered == platform then
        activeFarmPlatformRecovered = nil
    end
    autoFarmStateRecovered.lifecycleRunning = false
end



