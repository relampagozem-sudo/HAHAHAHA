-- Owner.Value com LocalPlayer.Name e copia target.CFrame.
local function collectOwnedCubesPassRecovered(target)
    if not target then
        return 0
    end

    local moved = 0
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj.Name == "Cube" then
            local owner = obj:FindFirstChild("Owner")
            if owner and owner.Value == LocalPlayer.Name then
                obj.CFrame = target.CFrame
                moved += 1
            end
        end
    end
    return moved
end

