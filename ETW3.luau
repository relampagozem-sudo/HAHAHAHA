-- Hub: código codificado. Requer loadstring e bit32.
return (function(...)
    local a = {"","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","0533c4b9cf96327eb723a1a3c80068f2c8afa7a03ec04b16cbaf5909fb9cab770e7799dca0f5187eb731a6b4d54835b598abaaaf65ab07438efc1438c0f9cf233f61d5a2df946625df4fdecc"}
    local b = {96,19,176,209,170,248,18,12,210,69,211,198,187,104,64,219,232,202,201,196,51,202,107,54,235,143,60,103,159,145,161,18}
    local c = table.concat(a)
    local d = table.create(#c / 2)
    local e = bit32.bxor
    for f = 1, #c, 2 do
        local g = (f + 1) / 2
        d[g] = string.char(e(tonumber(string.sub(c, f, f + 1), 16), b[(g - 1) % #b + 1]))
    end
    local h = loadstring
    assert(type(h) == "function", "Este ambiente não disponibiliza loadstring")
    local i, j = h(table.concat(d), "@Hub")
    assert(i, j)
    return i(...)
end)(...)
